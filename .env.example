# Copy this file to .env and replace the placeholders. Never commit .env.
# The key is needed only for live OpenAI routing. The offline demo and the
# public API checks use no OpenAI key.
OPENAI_API_KEY=your_api_key_here
# Optional. Use a model your account can access, or delete this line to use
# the built-in default. Do not leave the placeholder unchanged.
OPENAI_MODEL=your_model_name_here
